{
  "name": "agentvault-0g",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-custodial AI agent billing console with 0G Storage memory and 0G Chain audit proofs.",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"tsx server/index.ts\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "check:node": "tsc -p tsconfig.node.json",
    "contract:compile": "tsx scripts/compile-contract.ts",
    "deploy:0g": "tsx scripts/deploy.ts",
    "upload:sample": "tsx scripts/upload-sample.ts"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.9",
    "@vitejs/plugin-react": "^4.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "6.13.1",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "solc": "^0.8.28",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
